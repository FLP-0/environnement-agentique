{
  "name": "environnement-agentique",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Contrôleur personnel de tâches agentiques avec état PostgreSQL persistant.",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "worker": "node dist/worker-main.js",
    "migrate": "tsx src/migrate-main.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit.test.ts",
    "test:integration": "tsx --test tests/integration.test.ts",
    "check": "npm run typecheck && npm run test && npm run build",
    "setup": "node scripts/setup.mjs",
    "demo": "node scripts/demo.mjs",
    "codex:diagnostic": "tsx src/codex-diagnostic.ts"
  },
  "dependencies": {
    "fastify": "5.12.3",
    "pg": "8.23.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@openai/codex-sdk": "0.153.4",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
